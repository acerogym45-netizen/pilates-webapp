# ───── Hotel Mode Feature Flags (default: false) ─────
# 마스터 스위치. true로 설정해야 호텔 기능 전체가 활성화됨.
# 기존 아파트 단지에는 영향 없음 (기본값 false = 완전 비활성).
# 전환 절차: docs/ops/A4-FEATURE-FLAGS.md 참조
ENABLE_HOTEL_MODE=false

# 개별 기능 Flag (hotelMode=true인 상태에서만 효과 있음)
ENABLE_HOTEL_QUICK_CLASS=false
ENABLE_HOTEL_REFRESH_PT=false
ENABLE_HOTEL_MEMBER_PAGE=false
ENABLE_HOTEL_STAFF_AUTH=false
ENABLE_HOTEL_MEAL_ORDER=false
